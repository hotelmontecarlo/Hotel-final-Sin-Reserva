{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "reservas.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" },
    { "src": "js/**/*", "use": "@vercel/static" },
    { "src": "css/**/*", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "icon.png", "use": "@vercel/static" },
    { "src": "icon.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/reservas", "dest": "/reservas.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/sw\\.js", "dest": "/sw.js" },
    { "src": "/manifest\\.webmanifest", "dest": "/manifest.webmanifest" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
